{
  "name": "radian",
  "version": "0.0.0",
  "private": true,
  "description": "A terminal-based, AI-driven development editor powered by Pi Agent.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/oneable-dev/radian.git"
  },
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4.4"
  },
  "scripts": {
    "start": "bun src/index.ts",
    "dev": "bun src/index.ts",
    "restart": "bun src/index.ts runtime restart",
    "build": "bun build --compile --no-compile-autoload-dotenv --no-compile-autoload-bunfig src/index.ts --outfile dist/radian",
    "typecheck": "tsc --noEmit",
    "format": "bun fmt",
    "format:check": "bun fmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "bun test",
    "test:workspace": "bun src/testing/worktree-fixture.ts"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.2.0",
    "@earendil-works/pi-coding-agent": "1.2.0",
    "@opentui/core": "0.6.2",
    "@xterm/headless": "6.0.0",
    "commander": "15.0.0",
    "diff": "9.0.0",
    "typebox": "1.3.27",
    "web-tree-sitter": "0.25.10"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "typescript": "7.0.2"
  }
}
